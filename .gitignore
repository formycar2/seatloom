.DS_Store
.env
.env.*
node_modules/
dist/
build/
coverage/
.tmp/
.local/
test-results/
target/

# Local harness / runtime state — machine-specific, never committed.
# .seatloom/bootstrap/ stays tracked; only live runtime artifacts are ignored.
.gemini/
.seatloom/transcripts/
.seatloom/seat-sessions.tsv

# Cargo cache (CI populates .cargo/registry when CARGO_HOME=$CI_PROJECT_DIR/.cargo);
# only .cargo/config.toml is tracked.
.cargo/registry/
.cargo/git/
.rustup/

# Secrets — NEVER commit. Bare key files live here for local tooling only.
# (2026-10-10: key/ and gitlab_pat.txt were untracked but un-ignored; one `git add -A`
#  would have pushed them to GitLab. History verified clean via `git log -S` before fixing.)
key/
gitlab_pat.txt
*.key
*.pem
.local/secrets/

# Python bytecode (tools/wash pipeline)
__pycache__/
*.pyc

resume-contexts/

# saih/ — build workspace for the saih harness (vendored pi clone + node_modules
# + dist). 560 MB; never commit it into this repo.
saih/

# saih project-level config (mirrors .pi/mcp.json for the saih harness)
.saih/

# Backups made by saih/prepare-seat-switch.sh when patching seat scripts
*.pre-saih.bak

# 本地 git 备份(bundle)。它们是这个项目唯一的冗余副本,不该进版本库自己,
# 但也不该被当成可以随便删的临时文件 —— 生成方式见 scripts/backup-unpushed-branches.sh
backups/*.bundle

# 2026-11-02: dsh-super-agent 参考代码 clone 在此,含嵌套 .git,
# 曾导致 Aegis 的 git add -A 差点带进提交(Aegis 11:30 自报的同类坑)
temp/
