.DS_Store
.env
.env.*
node_modules/
dist/
build/
coverage/
.tmp/
.local/
test-results/
target/

# Local harness / runtime state — machine-specific, never committed.
# .seatloom/bootstrap/ stays tracked; only live runtime artifacts are ignored.
.gemini/
.seatloom/transcripts/
.seatloom/seat-sessions.tsv

# Cargo cache (CI populates .cargo/registry when CARGO_HOME=$CI_PROJECT_DIR/.cargo);
# only .cargo/config.toml is tracked.
.cargo/registry/
.cargo/git/
.rustup/

# Secrets — NEVER commit. Bare key files live here for local tooling only.
# (2026-10-10: key/ and gitlab_pat.txt were untracked but un-ignored; one `git add -A`
#  would have pushed them to GitLab. History verified clean via `git log -S` before fixing.)
key/
gitlab_pat.txt
*.key
*.pem
.local/secrets/
resume-contexts/
